# CapsASR 打包脚本（Arch；Release 分发优先，AUR 可选）
#
# 拆分双包:
#   capsasr       主包（Python 运行体 + Vulkan 引擎 + 控制命令/补全/文档）
#   capsasr-cuda  CUDA 引擎（depends: nvidia-utils cuda nccl；NVIDIA 用户加装，
#                 auto 模式下优先于 Vulkan，不装则探测自动跳过）
# 布局: /usr/bin/{capsasr,capsasr-daemon}（控制命令, 进 PATH）
#       /usr/lib/capsasr/{capsasr,engines,tools}（核心运行体, 不进 PATH, 防与系统 llama.cpp 冲突）
# CUDA 引擎在打包期用 patchelf 剥离 /opt/cuda RUNPATH（namcap: Insecure RUNPATH）；
# 运行期由 daemon 注入 LD_LIBRARY_PATH（capsasr/backend.py，兼容 CUDA_HOME 等任意安装位置）。
# 包不含模型与用户配置——装包后 `capsasr init` 完成（数据落 ~/.capsasr）。
#
# 发布前（顺序）:
#   1. 代码推上去并打 tag v$pkgver
#   2. 建 Release v$pkgver，上传两个引擎二进制 capsasr-engine-{vulkan,cuda}
#      （重编译加 -DGGML_NATIVE=OFF（可移植，勿用构建机指令集）
#        -DCMAKE_SKIP_RPATH=ON -DCMAKE_EXE_LINKER_FLAGS="-Wl,-z,relro,-z,now"；
#        CUDA 再加 -DCMAKE_CUDA_ARCHITECTURES="75;80;86;89;90;100;120-virtual"（编译机装 cuda 包即可,无需 NVIDIA 卡；nccl 可选）,
#        见 ARCHITECTURE.md §9 —— FULL RELRO 只能在链接期解决）
#   3. sha256sum 两个二进制，把真实值填进 sha256sums（源码归档可留 SKIP）
#   4. cd packaging && makepkg -sf（先 pacman -S patchelf），把
#      capsasr-*.zst 与 capsasr-cuda-*.zst 都上传到该 Release
#   5. （可选，AUR 恢复注册后）makepkg --printsrcinfo > .SRCINFO，与 PKGBUILD 提交 AUR
#
# 本地验证（未发布时，绕过网络；需 PATH 里有 patchelf；makepkg 的 source 不收绝对路径，
#   产物须以 source 基名出现在 PKGBUILD 目录，环境变量覆盖为裸文件名）:
#   tar --exclude='./models' --exclude='./engines' --exclude='./packaging' -czf packaging/src.tar.gz -C . .
#   cd packaging && ln -sf ../engines/capsasr-engine-{vulkan,cuda} . && _code=src.tar.gz makepkg -fd
#   namcap capsasr*-*.pkg.tar.zst
#   预期残留（均可解释）: 主包子进程运行依赖 W（keyd 等，namcap 静态分析看不见）、
#   capsasr-cuda 的 cublasLt unused W（链接器 as-needed 现象）与 capsasr 跨包依赖 W

pkgbase=capsasr
pkgname=(capsasr capsasr-cuda)
pkgver=0.5.0
pkgrel=1
pkgdesc="本地语音输入: 长按 CapsLock 说话, 松手识别粘贴 (引擎 Fun-ASR-Nano GGUF, 无 PyTorch)"
arch=(x86_64)
_repo="https://github.com/Wry-Zen/capsasr"
url="$_repo"
license=(MIT Apache-2.0)
options=(!debug)
makedepends=(patchelf)

: "${_code:=${_repo}/archive/refs/tags/v${pkgver}.tar.gz}"
: "${_engine:=${_repo}/releases/download/v${pkgver}/capsasr-engine-vulkan}"
: "${_engine_cuda:=${_repo}/releases/download/v${pkgver}/capsasr-engine-cuda}"
source=("$_code" "$_engine" "$_engine_cuda")
sha256sums=(SKIP 67d1e1c8c66374f8b90ffb5c7c98000851899cfcd788a6134ff9a0afc78e6854 d91b58bf7ff82630866ba392b5d5c79fc45f9551cdfbcf9787463ff2e496309a)

_prepare() {
    cd "$srcdir"
    # GitHub tag 归档解压后是 $pkgbase-$pkgver/ 顶层目录；本地验证 tarball 是扁平结构
    if [ -d "$pkgbase-$pkgver" ]; then
        cd "$pkgbase-$pkgver"
    fi
}

package_capsasr() {
    # libnotify 为可选依赖（notify-send 缺失时提示静默跳过，见 optdepends）；bash: capsasr-daemon/setup-keyd.sh
    depends=(bash glibc libstdc++ libgcc libgomp python keyd wl-clipboard ydotool pipewire pipewire-pulse vulkan-icd-loader)
    optdepends=(
      'libnotify: 桌面通知通道 notify-send（缺失时提示静默跳过）'
      'dms: DMS 悬浮 toast 通知通道（AUR/自行安装，缺失自动退回 notify-send）'
      'vulkan-tools: 设备探测回退'
      'bash-completion: bash 自动加载补全'
    )
    install=capsasr.install

    _prepare
    _app="$pkgdir/usr/lib/capsasr"
    install -dm755 "$_app/capsasr" "$_app/engines" "$_app/tools" "$pkgdir/usr/bin"

    install -Dm644 capsasr/*.py -t "$_app/capsasr/"
    install -m755 "$srcdir/capsasr-engine-vulkan" "$_app/engines/capsasr-engine-vulkan"
    install -Dm755 bin/capsasr bin/capsasr-daemon -t "$pkgdir/usr/bin/"
    install -Dm755 tools/setup-keyd.sh -t "$_app/tools/"
    install -Dm644 tools/funasr-cli.patch -t "$_app/tools/"

    install -Dm644 completions/capsasr.bash "$pkgdir/usr/share/bash-completion/completions/capsasr"
    install -Dm644 completions/_capsasr "$pkgdir/usr/share/zsh/site-functions/_capsasr"
    install -Dm644 completions/capsasr.fish "$pkgdir/usr/share/fish/vendor_completions.d/capsasr.fish"

    install -Dm644 /dev/stdin "$pkgdir/usr/share/doc/capsasr/README" <<'EOF'
初始化: capsasr init
体检:   capsasr doctor
热键:   sudo bash /usr/lib/capsasr/tools/setup-keyd.sh
EOF

    # namcap: 非通用许可证标识（MIT）要求随包提供文本
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/capsasr/MIT"
}

package_capsasr-cuda() {
    pkgdesc="CapsASR CUDA 引擎后端（sm_75–120a 七档 + 每档 PTX；auto 模式下优先于 Vulkan）"
    depends=(capsasr glibc libstdc++ libgcc libgomp nvidia-utils cuda)

    _prepare
    _app="$pkgdir/usr/lib/capsasr"
    install -dm755 "$_app/engines"
    install -m755 "$srcdir/capsasr-engine-cuda" "$_app/engines/capsasr-engine-cuda"
    # 剥离指向包外路径的 RUNPATH；运行期 daemon 注入 LD_LIBRARY_PATH 解析 cudart/cublas/nccl
    patchelf --remove-rpath "$_app/engines/capsasr-engine-cuda"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/capsasr-cuda/MIT"
}
