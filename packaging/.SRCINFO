pkgbase = capsasr
	pkgdesc = 本地语音输入: 长按 CapsLock 说话, 松手识别粘贴 (引擎 Fun-ASR-Nano GGUF, 无 PyTorch)
	pkgver = 0.5.1
	pkgrel = 1
	url = https://github.com/Wry-Zen/capsasr
	arch = x86_64
	license = MIT
	license = Apache-2.0
	makedepends = patchelf
	options = !debug
	source = https://github.com/Wry-Zen/capsasr/archive/refs/tags/v0.5.1.tar.gz
	source = https://github.com/Wry-Zen/capsasr/releases/download/v0.5.1/capsasr-engine-vulkan
	source = https://github.com/Wry-Zen/capsasr/releases/download/v0.5.1/capsasr-engine-cuda
	sha256sums = SKIP
	sha256sums = 67d1e1c8c66374f8b90ffb5c7c98000851899cfcd788a6134ff9a0afc78e6854
	sha256sums = d91b58bf7ff82630866ba392b5d5c79fc45f9551cdfbcf9787463ff2e496309a

pkgname = capsasr
	install = capsasr.install
	depends = bash
	depends = glibc
	depends = libstdc++
	depends = libgcc
	depends = libgomp
	depends = python
	depends = keyd
	depends = wl-clipboard
	depends = ydotool
	depends = pipewire
	depends = pipewire-pulse
	depends = vulkan-icd-loader
	optdepends = libnotify: 桌面通知通道 notify-send（缺失时提示静默跳过）
	optdepends = dms: DMS 悬浮 toast 通知通道（AUR/自行安装，缺失自动退回 notify-send）
	optdepends = vulkan-tools: 设备探测回退
	optdepends = bash-completion: bash 自动加载补全

pkgname = capsasr-cuda
	pkgdesc = CapsASR CUDA 引擎后端（sm_75–120a 七档 + 每档 PTX；auto 模式下优先于 Vulkan）
	depends = capsasr
	depends = glibc
	depends = libstdc++
	depends = libgcc
	depends = libgomp
	depends = nvidia-utils
	depends = cuda
